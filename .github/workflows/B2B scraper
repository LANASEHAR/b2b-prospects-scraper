name: B2B Prospects Scraper (Salons & Laveries)
pip install requests beautifulsoup4 lxml
# Mac/Linux:
export GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
python scraper_prospects_france.py

# Windows (Command Prompt):
set GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
python scraper_prospects_france.py

on:
  schedule:
    # Exécution automatique 2 fois par semaine (Lundi et Jeudi à 06h00 UTC)
    - cron: '0 6 * * 1,4'
  workflow_dispatch:

concurrency:
  group: b2b-scraper
  cancel-in-progress: false

jobs:
  scrape_and_sync:
    runs-on: ubuntu-latest
    timeout-minutes: 120

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Configuration de Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Installation des dépendances
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Exécution du Scraping & Synchronisation Google Sheets
        env:
          GOOGLE_SHEET_WEBHOOK_URL: ${{ secrets.GOOGLE_SHEET_WEBHOOK_URL }}
        run: |
          python scraper_prospects_france.py

      - name: Sauvegarde des exports CSV en artefact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: b2b-prospects-${{ github.run_id }}
          path: |
            laveries_france.csv
            salons_coiffure_france.csv
          if-no-files-found: ignore
          retention-days: 30
